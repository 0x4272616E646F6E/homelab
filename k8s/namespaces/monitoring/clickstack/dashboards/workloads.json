            "aggFn": "max",
            "valueExpression": "Value",
            "metricName": "k8s.container.cpu_request_utilization",
            "metricType": "gauge",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "alias": "of request",
            "numberFormat": {
              "output": "percent",
