    {
      "id": "running-pods-by-namespace",
      "x": 12,
      "y": 25,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Running pods by namespace",
        "source": "6a77f61f0befe6a492bcf6f0",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "Value",
            "metricName": "k8s.pod.phase",
            "metricType": "gauge",
            "aggCondition": "",
            "aggConditionLanguage": "sql"
          }
        ],
        "where": "Value = 2",
        "whereLanguage": "sql",
        "granularity": "auto",
        "alignDateRangeToGranularity": true,
        "groupBy": "ResourceAttributes['k8s.namespace.name']",
        "numberFormat": {
          "output": "number",
          "mantissa": 0,
          "thousandSeparated": true
        },
        "seriesLimit": 20
      }
    },
    {
      "id": "pods-not-running",
      "x": 0,
      "y": 32,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Pods not running",
        "source": "6a77f61f0befe6a492bcf6f0",
        "displayType": "table",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricName": "k8s.pod.phase",
            "metricType": "gauge",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "alias": "phase"
          }
        ],
        "where": "Value NOT IN (2, 3)",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.namespace.name'], ResourceAttributes['k8s.pod.name']",
        "limit": {
          "limit": 25
        },
        "description": "Phase 1 = Pending, 4 = Failed, 5 = Unknown. Empty is good.",
        "orderBy": "`phase` DESC"
      }
    },
    {
      "id": "container-restarts",
      "x": 12,
      "y": 32,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Container restarts",
        "source": "6a77f61f0befe6a492bcf6f0",
        "displayType": "table",
        "select": [
          {
            "aggFn": "max",
            "valueExpression": "Value",
            "metricName": "k8s.container.restarts",
            "metricType": "gauge",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "alias": "restarts"
          }
        ],
        "where": "Value > 0",
        "whereLanguage": "sql",
        "groupBy": "ResourceAttributes['k8s.namespace.name'], ResourceAttributes['k8s.pod.name'], ResourceAttributes['k8s.container.name']",
        "limit": {
          "limit": 25
        },
        "description": "Restart count since the pod was created.",
        "orderBy": "`restarts` DESC"
      }
    },
    {
      "id": "talos-logs-by-service",
      "x": 0,
      "y": 39,
      "w": 24,
      "h": 7,
      "config": {
        "name": "Talos logs by service",
        "source": "6a77f61f0befe6a492bcf6ec",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "",
            "aggConditionLanguage": "sql"
          }
        ],
        "where": "mapContains(LogAttributes, 'talos-level')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "groupBy": "ServiceName",
        "seriesLimit": 15
      }
    },
    {
      "id": "talos-warnings-and-errors",
      "x": 0,
      "y": 46,
      "w": 24,
      "h": 9,
      "config": {
        "name": "Talos warnings and errors",
        "source": "6a77f61f0befe6a492bcf6ec",
        "displayType": "search",
        "select": "Timestamp, ServiceName, SeverityText, Body",
        "where": "mapContains(LogAttributes, 'talos-level') AND SeverityNumber >= 13",
        "whereLanguage": "sql"
      }
    }
