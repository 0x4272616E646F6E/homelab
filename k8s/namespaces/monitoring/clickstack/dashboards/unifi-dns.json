    {
      "id": "dhcp-leases",
      "x": 12,
      "y": 20,
      "w": 12,
      "h": 9,
      "config": {
        "name": "DHCP leases",
        "source": "6a77f61f0befe6a492bcf6ec",
        "displayType": "table",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "",
            "aggConditionLanguage": "sql",
            "alias": "renewals"
          }
        ],
        "where": "Body LIKE '%dnsmasq-dhcp[%DHCPACK(%'",
        "whereLanguage": "sql",
        "groupBy": "extractGroups(Body, 'DHCPACK\\\\(\\\\S+\\\\) (\\\\S+) (\\\\S+) ?(.*)$')[1], extractGroups(Body, 'DHCPACK\\\\(\\\\S+\\\\) (\\\\S+) (\\\\S+) ?(.*)$')[2], extractGroups(Body, 'DHCPACK\\\\(\\\\S+\\\\) (\\\\S+) (\\\\S+) ?(.*)$')[3]",
        "limit": {
          "limit": 200
        },
        "description": "IP, MAC and hostname from gateway DHCP acknowledgements. Empty while the Client IP filter is set.",
        "orderBy": "`renewals` DESC"
      }
    },
