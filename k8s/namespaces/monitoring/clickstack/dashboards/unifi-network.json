        ],
        "where": "LogAttributes['cef_vendor'] = 'Ubiquiti' AND LogAttributes['appname'] = 'UniFi Protect'",
        "whereLanguage": "sql",
        "granularity": "auto",
        "groupBy": "LogAttributes['cef_name']",
        "seriesLimit": 15
      }
    },
    {
      "id": "device-syslog-by-host",
      "x": 12,
      "y": 19,
      "w": 12,
      "h": 7,
      "config": {
        "name": "Device syslog by host",
        "source": "6a77f61f0befe6a492bcf6ec",
        "displayType": "stacked_bar",
        "select": [
          {
            "aggFn": "count",
            "valueExpression": "",
            "aggCondition": "",
            "aggConditionLanguage": "sql"
          }
        ],
        "where": "ScopeName LIKE '%syslogreceiver' AND NOT mapContains(LogAttributes, 'cef_name')",
        "whereLanguage": "sql",
        "granularity": "auto",
        "groupBy": "LogAttributes['hostname']",
        "seriesLimit": 15
      }
    },
    {
      "id": "recent-firewall-blocks",
      "x": 0,
      "y": 26,
      "w": 24,
      "h": 9,
      "config": {
        "name": "Recent firewall blocks",
        "source": "6a77f61f0befe6a492bcf6ec",
        "displayType": "search",
        "select": "Timestamp, extract(LogAttributes['cef_extension'], 'UNIFIsrcClient(?:Alias|Hostname)=(.*?) UNIFI') AS source, coalesce(nullIf(extract(LogAttributes['cef_extension'], 'UNIFIdstDomain=(\\\\S+)'), ''), nullIf(extract(LogAttributes['cef_extension'], 'UNIFIdstDeviceName=(.*?) UNIFI'), ''), extract(LogAttributes['cef_extension'], ' dst=(\\\\S+)')) AS destination, concat(extract(LogAttributes['cef_extension'], ' proto=(\\\\S+)'), '/', extract(LogAttributes['cef_extension'], ' dpt=([0-9]+)')) AS port, extract(LogAttributes['cef_extension'], 'UNIFIpolicyName=(.*?) UNIFIpolicyType=') AS policy",
        "where": "LogAttributes['cef_vendor'] = 'Ubiquiti' AND LogAttributes['cef_name'] = 'Blocked by Firewall'",
        "whereLanguage": "sql"
      }
    },
    {
      "id": "recent-unifi-os-and-protect-events",
      "x": 0,
      "y": 35,
      "w": 24,
      "h": 9,
      "config": {
        "name": "Recent UniFi OS and Protect events",
        "source": "6a77f61f0befe6a492bcf6ec",
        "displayType": "search",
        "select": "Timestamp, LogAttributes['appname'] AS app, LogAttributes['cef_name'] AS event, LogAttributes['message'] AS message",
        "where": "LogAttributes['cef_vendor'] = 'Ubiquiti' AND LogAttributes['appname'] != 'UniFi Network'",
        "whereLanguage": "sql"
      }
    }
